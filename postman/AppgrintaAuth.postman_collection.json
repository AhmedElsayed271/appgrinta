{
  "info": {
    "name": "appgrinta",
    "description": "Grinta API - Auto-saves api_token & biometric_token after login/social/google/biometric-login into collection variables. base_url = server + /api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Ahmed\",\n    \"email\": \"user@example.com\",\n    \"password\": \"12345678\",\n    \"password_confirmation\": \"12345678\",\n    \"fb_token\": \"expo_push_token_here\",\n    \"locale\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.token) { pm.collectionVariables.set('api_token', j.data.token); }",
                  "if (j && j.data && j.data.biometric_token) { pm.collectionVariables.set('biometric_token', j.data.biometric_token); }"
                ]
              }
            }
          ]
        },
