                  "pm.test('target_id is the internal team id', function () {",
                  "    var d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('target_id', 583);",
                  "    pm.expect(d).to.have.property('team_id', 50);",
                  "});",
                  "var json = pm.response.json();",
