            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/deeplinks/click",
            "description": "Optional analytics: increments clicks_count and returns the same payload as resolve."
          }
        },
        {
          "name": "Claim iOS code",
