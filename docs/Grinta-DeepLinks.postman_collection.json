                  "    pm.expect(d).to.not.have.property('match_id');",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.code) {",
                  "    pm.collectionVariables.set('code', json.data.code);",
                  "    console.log('Saved {{code}} = ' + json.data.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"match\",\n  \"id\": 1367248,\n  \"screen\": \"2\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/deeplinks",
            "description": "Send the external Football API `fixture_id` directly in `id`. The server matches only against `fixture_id`, stores the internal id in `target_id`, and returns `fixture_id` as a helper. Our internal id is not accepted (see the negative request above). No `match_id` key is returned."
          }
        },
