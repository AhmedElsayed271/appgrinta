              "raw": "{\n  \"type\": \"team\",\n  \"id\": 583,\n  \"screen\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/deeplinks",
            "description": "Create (or reuse) a code for a team using our internal `id`. The response also returns the external `team_id` as a helper."
          }
        },
        {
          "name": "Create - team by football_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('target_id is the internal team id', function () {",
                  "    var d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('target_id', 583);",
                  "    pm.expect(d).to.have.property('team_id', 50);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.code) {",
                  "    pm.collectionVariables.set('code', json.data.code);",
                  "    console.log('Saved {{code}} = ' + json.data.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"team\",\n  \"football_id\": 50,\n  \"screen\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/deeplinks",
            "description": "Send the external Football API `team_id` in `football_id`; the server resolves it to the internal id and reuses the same code as the `id` request above."
          }
        },
