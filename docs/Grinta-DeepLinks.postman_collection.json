    {
      "name": "Use code",
      "item": [
        {
          "name": "Resolve code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Old contract keys exist', function () {",
                  "    var d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('target_type');",
                  "    pm.expect(d).to.have.property('target_id');",
                  "});",
                  "pm.test('screen is a fixed key', function () {",
                  "    var d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('screen');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/deeplinks/resolve?code={{code}}",
            "description": "Turn {{code}} back into a content target. {{code}} is filled automatically by any 'Create link' request."
          }
        },
        {
